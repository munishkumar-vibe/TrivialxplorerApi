# ─────────────────────────────────────────────────────────────
# TRAVELXPLORER — BACKEND ENVIRONMENT
# api/.env
#
# This file is gitignored. Never commit real secrets.
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────
# DATABASE — MongoDB
# ─────────────────────────────────────────────
# Local MongoDB (default) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/xplorer
# Milliseconds to wait before giving up on a server selection
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_STRONG_RANDOM_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_64_BYTE_HEX_SECRET
# Access token lifetime (returned as userAccessToken on signin — kept short)
JWT_ACCESS_EXPIRES_IN=2h
# Refresh token lifetime (stored in httpOnly cookie)
JWT_REFRESH_EXPIRES_IN=1d

# ─────────────────────────────────────────────
# COOKIE
# ─────────────────────────────────────────────
# Must match JWT_REFRESH_EXPIRES_IN in days
COOKIE_MAX_AGE_DAYS=1

# ─────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────
# Maximum concurrent login sessions per user (oldest is evicted when exceeded)
MAX_SESSIONS_PER_USER=5

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# bcrypt cost factor — 12 is the production-standard minimum
BCRYPT_SALT_ROUNDS=12
# Max request body size accepted by Express
REQUEST_BODY_LIMIT=10kb

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
# How many minutes the emailed reset link stays valid
PASSWORD_RESET_EXPIRES_MINUTES=10

# ─────────────────────────────────────────────
# EMAIL — SMTP
# ─────────────────────────────────────────────
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM_NAME=TravelXplorer
EMAIL_FROM_ADDRESS=noreply@travelxplorer.com

# ─────────────────────────────────────────────
# CLIENT
# ─────────────────────────────────────────────
# Frontend URL — used for CORS allow-list and the password-reset link in emails
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
# Global limiter — all routes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth-specific limiter — signup, signin, forgot-password, reset-password
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
