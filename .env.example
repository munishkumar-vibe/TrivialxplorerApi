# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────
# DATABASE — MongoDB
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/myapp
# How long (ms) to wait before giving up on finding a MongoDB server
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
# Access token lifetime (userAccessToken returned on signin)
JWT_ACCESS_EXPIRES_IN=2h
# Refresh token lifetime (stored in httpOnly cookie)
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# COOKIE
# ─────────────────────────────────────────────
# How many days the refresh token cookie stays alive (should match JWT_REFRESH_EXPIRES_IN)
COOKIE_MAX_AGE_DAYS=7

# ─────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────
# Max number of simultaneous login sessions per user (oldest is dropped when exceeded)
MAX_SESSIONS_PER_USER=5

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# bcrypt cost factor — higher = slower hash = safer (12 is production standard)
BCRYPT_SALT_ROUNDS=12
# Maximum allowed request body size
REQUEST_BODY_LIMIT=10kb

# ─────────────────────────────────────────────
# PASSWORD RESET
# ─────────────────────────────────────────────
# How many minutes the password reset link stays valid
PASSWORD_RESET_EXPIRES_MINUTES=10

# ─────────────────────────────────────────────
# EMAIL — SMTP
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=MyApp
EMAIL_FROM_ADDRESS=noreply@myapp.com

# ─────────────────────────────────────────────
# CLIENT
# ─────────────────────────────────────────────
# Your frontend URL — used for CORS and password reset link
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
# Global rate limit (all routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth-specific rate limit (signup, signin, forgot-password, reset-password)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
